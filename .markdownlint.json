# ── Markdownlint config ──
# See https://github.com/DavidAnson/markdownlint

# Default state
default: true

# Line length — relax for normal prose
MD013:
  line_length: 120
  heading_line_length: 80
  code_block_line_length: 120
  tables: false

# Multiple headings with same content — allow in CHANGELOG
MD024:
  allow_different_nesting: true

# Inline HTML — allow (needed for badge images)
MD033: false

# First line in file should be top-level heading — allow in some files
MD041: false

# Emphasis used instead of heading — allow
MD036: false
